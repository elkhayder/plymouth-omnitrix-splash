screen.width = Window.GetWidth();
screen.height = Window.GetHeight();

Window.SetBackgroundTopColor(0.035, 0.035, 0.043);
Window.SetBackgroundBottomColor(0.035, 0.035, 0.043);

frame_count = 50;
frame_images = [];
for (i = 0; i < frame_count; i++) {
    frame_images[i] = Image("images/omnitrix-frame-" + i + ".png");
}

sprite = Sprite();
target_size = screen.height * 0.40 * 1020 / 500;
sprite.SetImage(frame_images[0].Scale(target_size, target_size));
sprite.SetOpacity(1);
sprite.SetZ(15);
sprite.SetX((screen.width - target_size) / 2);
sprite.SetY((screen.height - target_size) / 2);

frame_index = 0;
refresh_count = 0;

fun refresh_callback () {
    refresh_count += 1;
    if (refresh_count >= 3) {
        refresh_count = 0;
        frame_index = (frame_index + 1) % frame_count;
        sprite.SetImage(frame_images[frame_index].Scale(target_size, target_size));
    }
}

Plymouth.SetRefreshFunction (refresh_callback);

fun quit_callback () {
    sprite.SetOpacity(0);
}

Plymouth.SetQuitFunction(quit_callback);